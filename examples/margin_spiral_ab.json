 "design": {
  "design_type": "ab",
  "question": "Does the leverage cap determine whether the pump-and-dump ends in a liquidation spiral?",
  "hypothesis": "A loose initial margin (10x leverage cap) produces forced liquidations and materially larger drawdowns than a tight cap (2x) under the same shock sequence.",
  "independent_variables": [
   "risk.initial_margin"
  ],
  "dependent_variables": [
   "max_drawdown",
   "risk_forced_volume",
   "risk_liquidation_slices",
   "risk_margin_calls",
   "risk_max_leverage",
   "total_return"
  ],
  "primary_metric": "max_drawdown",
  "control": {
   "name": "tight_margin_2x",
   "overrides": {
    "risk.initial_margin": 0.5
   }
  },
  "treatments": [
   {
    "name": "loose_margin_10x",
    "overrides": {
     "risk.initial_margin": 0.1
    }
   }
  ],
  "replications": 20
 }
