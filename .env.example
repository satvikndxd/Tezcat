# Persistence backend: local | aws
TEZCAT_STORE=local
# Local data directory (local store)
TEZCAT_DATA_DIR=data
# Path to the built dashboard (defaults to frontend/dist)
# TEZCAT_FRONTEND_DIST=frontend/dist

# --- Frontend build variables ---
# Empty/unset keeps the Vite dev proxy on /api -> http://localhost:8000.
# Set this to the public backend origin for GitHub Pages builds, for example:
# VITE_API_BASE_URL=https://tezcat-public-api.onrender.com
# VITE_BASE_PATH=/Tezcat/

# --- AWS store only ---
# TEZCAT_S3_BUCKET=tezcat-lab-<account>
# TEZCAT_TABLE_EXPERIMENTS=TezcatExperiments
# TEZCAT_TABLE_RUNS=TezcatRuns
# TEZCAT_CHUNK_STEPS=5000
# AWS_REGION=us-east-1

# --- Public demo guardrails ---
# Render's blueprint supplies these; leave unset locally.
# TEZCAT_PUBLIC_DEMO=true
# TEZCAT_PUBLIC_MAX_RUNS=60
# TEZCAT_PUBLIC_MAX_STEPS=5000
# TEZCAT_PUBLIC_MAX_ACTIVE_BATCHES=1
# TEZCAT_PUBLIC_MAX_ACTIVE_RUNS=1
# TEZCAT_PUBLIC_MAX_SERIES=2000
# External Event-Market Intelligence Layer (server-side only; no provider secrets required for public reads)
# TEZCAT_PUBLIC_MAX_EXTERNAL_ITEMS=50
# TEZCAT_PUBLIC_MAX_EXTERNAL_DATASETS=25
# TEZCAT_PUBLIC_EXTERNAL_MIN_INTERVAL=10
# No scheduled provider scraper is configured.
# TEZCAT_CORS_ORIGINS=https://satvikndxd.github.io,http://localhost:5173,http://localhost:4173
